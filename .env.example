# Copy to .env (or .env.local) and adjust. Only EXPO_PUBLIC_* variables reach the app bundle,
# so never put secrets here.

# Base URL of the Vedic Engine (FastAPI). A phone cannot reach 127.0.0.1 on your PC:
# use your PC's LAN address (e.g. http://192.168.1.20:8000) or a deployed engine URL.
# Android emulator: http://10.0.2.2:8000   iOS simulator / web: http://127.0.0.1:8000
EXPO_PUBLIC_ENGINE_URL=https://vedic-engine-eight.vercel.app/engine

# Optional: the Next.js web app, used for "open full report on web" links.
EXPO_PUBLIC_WEB_URL=https://vedic-engine-eight.vercel.app/engine

# Request timeout in milliseconds (reports and AI answers can be slow).
EXPO_PUBLIC_API_TIMEOUT_MS=60000

# development | staging | production (shown in Settings, toggles debug info)
EXPO_PUBLIC_APP_ENV=development
